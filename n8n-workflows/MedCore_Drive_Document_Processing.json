        "attributes": {
          "attributes": [
            {
              "name": "document_type",
              "description": "Choose one: invoice, request, report, complaint, contract, quote, or other."
            },
            {
              "name": "sender_or_company",
              "description": "Return the clearly identifiable name of the person or organization connected to the document. Do not treat initials, an ambiguous signature, generic labels, or incomplete identifiers as a confirmed sender. Use Not found when the sender or organization cannot be reliably identified."
            },
            {
              "name": "summary",
              "description": "Explain the document in no more than three short sentences."
            },
            {
              "name": "requested_action",
              "description": "State what the company should do next. Use No action found when absent."
            },
            {
              "name": "deadline",
              "description": "Extract only the actual deadline date or date/time, without surrounding wording.  Examples: \"Valid through 13 September 2026\" → \"13 September 2026\" \"Technician response requested by 10:00 on 7 September 2026\" → \"7 September 2026, 10:00\" \"Please respond no later than 14 September 2026\" → \"14 September 2026\"  If no deadline is stated, return exactly: Not found  Do not infer or invent a deadline. Do not include wording such as \"valid through\", \"requested by\", \"before\", or \"no later than\"."
            },
            {
              "name": "urgency",
              "description": "Return only Low, Medium, or High. High only for an immediate deadline, payment risk, legal or safety risk, or an explicit urgent request."
            },
            {
              "name": "department",
              "description": "Choose one: Sales, Finance, Support, HR, Management, or General."
            },
            {
              "name": "status",
              "description": "Return Processed only when the document contains enough specific information for an employee to understand what it concerns and what, if anything, should happen next. Return Needs Review when important context is missing, the sender cannot be reliably identified, the subject or request is vague, information is contradictory or unreadable, or an employee would need to ask for clarification before acting."
            }
          ]
        },
        "options": {
          "systemPromptTemplate": "Read the document like an office assistant. Extract only information that appears in the document. Do not invent missing details. Use Not found when information is missing."
        }
