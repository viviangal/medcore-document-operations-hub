# Copy this file to .env and fill in real values there.
# .env is git-ignored. This file must contain placeholders only.

# --- server side only (never reaches the browser bundle) ---
# The Express server calls N8N_BASE_URL + the path below for each endpoint,
# adding the x-api-key header from N8N_SECRET. GET /documents, POST
# /process-document and POST /review are all connected. Leave N8N_BASE_URL or
# N8N_SECRET empty to keep every route returning NOT_CONFIGURED.
N8N_BASE_URL=https://your-n8n-host/webhook
N8N_PROCESS_PATH=/process-document
N8N_DOCUMENTS_PATH=/documents
N8N_REVIEW_PATH=/review
N8N_SECRET=replace-me
REQUEST_TIMEOUT_MS=90000
MAX_FILE_MB=10

# Port the Express server listens on (the Vite dev server proxies /api here).
PORT=5174

# --- browser side (VITE_ variables ARE bundled: never put a secret here) ---
VITE_MAX_FILE_MB=10
