# Copy this file to .env and fill in real values there.
# .env is git-ignored. This file must contain placeholders only.

# --- server side only (never reaches the browser bundle) ---
# The Express server calls N8N_BASE_URL + the path below for each endpoint,
# adding the x-api-key header from N8N_SECRET. GET /documents, POST
# /process-document and POST /review are all connected. Leave N8N_BASE_URL or
# N8N_SECRET empty to keep every route returning NOT_CONFIGURED.
N8N_BASE_URL=https://your-n8n-host/webhook
N8N_PROCESS_PATH=/process-document
N8N_DOCUMENTS_PATH=/documents
N8N_REVIEW_PATH=/review
N8N_SECRET=replace-me
REQUEST_TIMEOUT_MS=90000
MAX_FILE_MB=10

# Port the Express server listens on (the Vite dev server proxies /api here).
PORT=5174

# --- browser side (VITE_ variables ARE bundled: never put a secret here) ---
VITE_MAX_FILE_MB=10
# --- GitHub Pages production build only ---
# Leave both unset for local development and for the default `npm run build`.
# If used elsewhere, src/api/client.js then falls back to the existing /api
# proxy exactly as before, and none of this section has any effect.
#
# Because Vite bakes every VITE_ variable into the static bundle
# at build time, and GitHub Pages has no server to keep anything private, NEITHER of
# these variables may ever hold a secret. There is deliberately no
# VITE_N8N_SECRET (or equivalent) here -- see README (M7) for the resulting
# limitation on this deployment target.
#
# VITE_API_MODE=direct switches the browser from the Express proxy to
# calling the hosted n8n webhook directly, using VITE_N8N_BASE_URL as the
# base (the same /documents, /process-document and /review paths already
# used by the proxy are reused unchanged; only the base URL differs).
VITE_API_MODE=proxy
VITE_N8N_BASE_URL=